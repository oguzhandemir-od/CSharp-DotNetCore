  order.api:
    build:
      context: C:\Users\oğuzhan\Desktop\CSharp-DotNetCore\Playground\MicroservicesNotificationCenter
      dockerfile: Order.API/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: Order.API
      target: base
    container_name: order_api_container
    depends_on:
