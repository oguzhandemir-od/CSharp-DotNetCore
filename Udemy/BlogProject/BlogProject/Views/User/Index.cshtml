@using BlogProject.Features.Users.DTOs
@model List<UserViewDto>

@{
    ViewData["Title"] = "kullanıcı yönetimi";
    Layout = "_AdminLayout";
}

<div class="table-responsive">
    <div style="padding: 20px 24px; border-bottom: 1px solid var(--admin-border);">
        <h3 style="font-family: var(--font-serif); font-size: 20px; font-weight: 600; margin: 0;">sistemdeki kullanıcılar</h3>
    </div>

    <table class="modern-table">
        <thead>
            <tr>
                <th>kullanıcı adı</th>
                <th>ad soyad</th>
                <th>e-posta</th>
                <th>rol / yetki</th>
                <th>toplam yazı</th>
                <th style="text-align: right; width: 180px;">işlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.Id">
                    <td>
                        <div style="font-weight: 600;">@@@item.Username</div>
                    </td>

                    <td class="user-fullname">@item.FullName</td>

                    <td style="color: var(--admin-text-muted);">@item.Email</td>

                    <td>
                        @if (item.Role == "Admin")
                        {
                            <span class="admin-badge" style="background: rgba(224, 90, 71, 0.12); color: var(--admin-accent); font-weight: 600;">yönetici</span>
                        }
                        else if (item.Role == "Author" || item.Role == "Yazar")
                        {
                            <span class="admin-badge badge-success">yazar</span>
                        }
                        else
                        {
                            <span class="admin-badge" style="background: rgba(0,0,0,0.04); color: var(--admin-text-muted); border: 1px solid var(--admin-border) !important;">okuyucu</span>
                        }
                    </td>

                    <td>
                        <span class="admin-badge badge-warning" style="font-weight: 600;">@item.PostCount yazı</span>
                    </td>

                    <td style="text-align: right;">
                        @if (item.Role != "Admin")
                        {
                            <div class="admin-btn-group" style="justify-content: flex-end;">
                                <button class="admin-btn-sm edit-btn"
                                        data-id="@item.Id"
                                        data-fullname="@item.FullName"
                                        data-role="@item.Role"
                                        style="background: rgba(0,0,0,0.03); border: 1px solid var(--admin-border) !important;">
                                    düzenle
                                </button>
                                <button class="admin-btn-sm btn-admin-danger delete-btn" data-id="@item.Id">
                                    sil
                                </button>
                            </div>
                        }
                        else
                        {
                            <span style="font-family: var(--font-mono); font-size: 11px; color: var(--admin-text-muted); padding-right: 12px;">sistem koruması</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="admin-modal-overlay" id="confirmModal">
    <div class="admin-modal-card">
        <div class="admin-modal-header">
            <h3 id="confirmModalTitle">Kullanıcı İşlemi</h3>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('confirmModal')">&times;</button>
        </div>
        <div class="admin-modal-body">
            <p id="confirmModalBody"></p>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="admin-btn-sm" style="background: rgba(0,0,0,0.05);" onclick="closeAdminModal('confirmModal')">vazgeç</button>
            <button type="button" class="admin-btn-sm btn-admin-danger" id="btnConfirmAction">Evet, Kullanıcıyı Sil</button>
        </div>
    </div>
</div>

<div class="admin-modal-overlay" id="editModal">
    <div class="admin-modal-card">
        <div class="admin-modal-header">
            <h3>kullanıcı yetki ve bilgilerini düzenle</h3>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('editModal')">&times;</button>
        </div>
        <div class="admin-modal-body">
            <input type="hidden" id="editUserId" />

            <div style="margin-bottom: 1.25rem;">
                <label for="editFullName" style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">ad soyad</label>
                <input type="text" id="editFullName" autocomplete="off" />
            </div>

            <div style="margin-bottom: 1rem;">
                <label for="editRole" style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">kullanıcı rolü</label>
                <select id="editRole">
                    <option value="Member">Member (Okuyucu)</option>
                    <option value="Author">Author (Yazar)</option>
                    <option value="Admin">Admin (Yönetici)</option>
                </select>
            </div>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="admin-btn-sm" style="background: rgba(0,0,0,0.05);" onclick="closeAdminModal('editModal')">iptal</button>
            <button type="button" class="admin-btn-sm btn-admin-dark" id="btnSaveUser">değişiklikleri kaydet</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function openAdminModal(modalId) {
        $(`#${modalId}`).css('display', 'flex').hide().fadeIn(150);
        }
        function closeAdminModal(modalId) {
        $(`#${modalId}`).fadeOut(150);
        }

        $(document).ready(function () {
        let targetId = "";
        let targetUrl = "";

        const baseRoute = "/User";

        $('.delete-btn').click(function () {
        targetId = $(this).data('id');
        targetUrl = `${baseRoute}/DeleteUser`;

        $('#confirmModalTitle').text("kullanıcı kaydını sil");
        $('#confirmModalBody').text("Bu kullanıcıyı sistemden tamamen silmek istediğinize emin misiniz? Kullanıcının tüm oturumları sonlandırılacak ve panele erişimi engellenecektir.");
        $('#btnConfirmAction').removeClass().addClass('admin-btn-sm btn-admin-danger').text("evet, kullanıcıyı sil");
        openAdminModal('confirmModal');
        });

        $('#btnConfirmAction').click(function () {
        $.ajax({
        type: "POST",
        url: targetUrl,
        data: { id: targetId },
        success: function (response) {
        closeAdminModal('confirmModal');
        if (response.isSuccess || response.success) {
        $(`#row-${targetId}`).fadeOut(400, function() { $(this).remove(); });
        } else {
        alert(response.message || "İşlem sırasında bir hata oluştu.");
        }
        },
        error: function() {
        closeAdminModal('confirmModal');
        alert("Teknik bir sorun nedeniyle kullanıcı silinemedi.");
        }
        });
        });

        $('.edit-btn').click(function () {
        let id = $(this).data('id');
        let fullName = $(this).data('fullname');
        let role = $(this).data('role');

        $('#editUserId').val(id);
        $('#editFullName').val(fullName);
        $('#editRole').val(role);
        openAdminModal('editModal');
        setTimeout(() => $('#editFullName').focus(), 200);
        });

        $('#btnSaveUser').click(function () {
        let id = $('#editUserId').val();
        let fullName = $('#editFullName').val().trim();
        let role = $('#editRole').val();

        if (!fullName) {
        alert("Ad Soyad alanı boş bırakılamaz!");
        return;
        }

        $.ajax({
        type: "POST",
        url: `${baseRoute}/EditUser`,
        data: { id: id, fullName: fullName, role: role },
        success: function (response) {
        closeAdminModal('editModal');
        if (response.success || response.isSuccess) {
        location.reload();
        } else {
        alert(response.message || "Güncelleme başarısız.");
        }
        },
        error: function() {
        closeAdminModal('editModal');
        alert("Sunucu hatası nedeniyle bilgiler güncellenemedi.");
        }
        });
        });
        });
    </script>
}