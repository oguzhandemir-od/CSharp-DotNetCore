@using BlogProject.Features.Users.DTOs
@model List<UserViewDto>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container mt-4">
    <h2>Kullanıcı Yönetim Paneli</h2>
    <hr />

    <table class="table table-hover table-striped align-middle">
        <thead>
            <tr>
                <th>Kullanıcı Adı</th>
                <th>Ad Soyad</th>
                <th>E-posta</th>
                <th>Rol / Yetki</th>
                <th>Toplam Yazı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.Id">
                    <td><strong>@item.Username</strong></td>
                    <td class="user-fullname">@item.FullName</td>
                    <td>@item.Email</td>
                    <td>
                        @if (item.Role == "Admin")
                        {
                            <span class="badge bg-danger user-role">@item.Role</span>
                        }
                        else if (item.Role == "Author")
                        {
                            <span class="badge bg-primary user-role">Yazar (@item.Role)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary user-role">Okuyucu (@item.Role)</span>
                        }
                    </td>
                    <td><span class="badge bg-light text-dark">@item.PostCount Yazı</span></td>
                    <td>
                        

                        @if (item.Role != "Admin") 
                        {
                            <button class="btn btn-sm btn-outline-primary edit-btn"
                                    data-id="@item.Id"
                                    data-fullname="@item.FullName"
                                    data-role="@item.Role"
                                    title="Düzenle">
                                Düzenle
                            </button>
                            <button class="btn btn-sm btn-outline-danger delete-btn" data-id="@item.Id" title="Sil">
                                Sil
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalTitle">İşlem Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmModalBody"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn" id="btnConfirmAction">Evet, Devam Et</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kullanıcı Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editUserId" />

                <div class="mb-3">
                    <label for="editFullName" class="form-label">Ad Soyad</label>
                    <input type="text" class="form-control" id="editFullName" />
                </div>

                <div class="mb-3">
                    <label for="editRole" class="form-label">Kullanıcı Rolü</label>
                    <select class="form-select" id="editRole">
                        <option value="Member">Member (Okuyucu)</option>
                        <option value="Author">Author (Yazar)</option>
                        <option value="Admin">Admin (Yönetici)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="btnSaveUser">Değişiklikleri Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let targetId = "";
            let targetUrl = "";

            // --- SİLME  ---
            $('.delete-btn').click(function () {
                targetId = $(this).data('id');
                targetUrl = "/User/DeleteUser";

                $('#confirmModalTitle').text("Kullanıcıyı Sil");
                $('#confirmModalBody').text("Bu kullanıcıyı silmek istediğinize emin misiniz? Kullanıcı sisteme giriş yapamayacaktır.");
                $('#btnConfirmAction').removeClass().addClass('btn btn-danger').text("Evet, Kullanıcıyı Sil");
                $('#confirmModal').modal('show');
            });

                    $('#btnConfirmAction').click(function () {
            $.ajax({
                type: "POST",
                url: targetUrl,
                data: { id: targetId },
                success: function (response) {
                    $('#confirmModal').modal('hide');

                    if (response.isSuccess) {
                        $(`#row-${targetId}`).fadeOut(500, function() { $(this).remove(); });
                    } else {
                        alert(response.message);
                    }
                }
            });
        });

            // --- DÜZENLE  ---
            $('.edit-btn').click(function () {
                let id = $(this).data('id');
                let fullName = $(this).data('fullname');
                let role = $(this).data('role');

                $('#editUserId').val(id);
                $('#editFullName').val(fullName);
                $('#editRole').val(role);
                $('#editModal').modal('show');
            });

            // --- DÜZENLE KAYDET 
            $('#btnSaveUser').click(function () {
                let id = $('#editUserId').val();
                let fullName = $('#editFullName').val();
                let role = $('#editRole').val();

                $.ajax({
                    type: "POST",
                    url: "/User/EditUser",
                    data: { id: id, fullName: fullName, role: role },
                    success: function (response) {
                        $('#editModal').modal('hide');
                        if (response.success) {
                            $(`#row-${id} .user-fullname`).text(fullName);

                            $(`#row-${id} .edit-btn`).data('fullname', fullName).data('role', role);

                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    }
                });
            });
        });
    </script>
}