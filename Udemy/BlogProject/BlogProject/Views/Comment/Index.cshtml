@using BlogProject.Features.Comments.DTOs
@model List<AdminCommentDto>

@{
    ViewData["Title"] = "yorum denetimi";
    Layout = "_AdminLayout";
}

<div class="table-responsive">
    <table class="modern-table">
        <thead>
            <tr>
                <th>kullanıcı</th>
                <th>makale</th>
                <th>yorum içeriği</th>
                <th>durum</th>
                <th>tarih</th>
                <th style="text-align: right;">işlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.Id">
                    <td>
                        <div style="font-weight: 600;">@item.Username</div>
                        <div style="font-size: 11px; color: var(--admin-text-muted); font-family: var(--font-mono);">yazar / okur</div>
                    </td>

                    <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @item.PostTitle
                    </td>

                    <td>
                        <div class="comment-wrapper-cell">
                            @if (item.Content.Length > 50)
                            {
                                <div class="comment-preview-block" id="preview-@item.Id">
                                    <span class="comment-text">@item.Content.Substring(0, 50)...</span>
                                    <button type="button" class="admin-detail-toggle-btn" onclick="toggleCommentDetail('@item.Id')">detayını gör</button>
                                </div>
                                <div class="comment-full-block" id="full-@item.Id" style="display: none;">
                                    <span class="comment-text">@item.Content</span>
                                    <button type="button" class="admin-detail-toggle-btn text-muted" onclick="toggleCommentDetail('@item.Id')">kapat</button>
                                </div>
                            }
                            else
                            {
                                <span class="comment-text">@item.Content</span>
                            }
                        </div>
                    </td>

                    <td>
                        @if (item.Status == "Approved" || item.Status == "Onaylandı")
                        {
                            <span class="admin-badge badge-success">onaylandı</span>
                        }
                        else if (item.Status == "Pending" || item.Status == "Beklemede")
                        {
                            <span class="admin-badge badge-warning">onay bekliyor</span>
                        }
                        else
                        {
                            <span class="admin-badge" style="background: rgba(224, 90, 71, 0.1); color: var(--admin-accent);">reddedildi</span>
                        }
                    </td>

                    <td style="font-family: var(--font-mono); font-size: 12px; color: var(--admin-text-muted);">
                        @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td style="text-align: right;">
                        <div class="admin-btn-group" style="justify-content: flex-end;">
                            @if (item.Status != "Approved" && item.Status != "Onaylandı")
                            {
                                <button class="admin-btn-sm btn-admin-success status-btn" data-id="@item.Id" data-status="Approved">onayla</button>
                            }
                            @if (item.Status != "Rejected" && item.Status != "Reddedildi")
                            {
                                <button class="admin-btn-sm btn-admin-danger reject-btn" data-id="@item.Id" data-status="Rejected">reddet</button>
                            }
                            <button class="admin-btn-sm btn-admin-dark edit-btn" data-id="@item.Id">düzenle</button>
                            <button class="admin-btn-sm btn-admin-danger delete-btn" data-id="@item.Id" style="background:transparent; border:1px solid var(--admin-border) !important;">sil</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="admin-modal-overlay" id="confirmModal">
    <div class="admin-modal-card">
        <div class="admin-modal-header">
            <h3 id="confirmModalTitle">İşlem Onayı</h3>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('confirmModal')">&times;</button>
        </div>
        <div class="admin-modal-body">
            <p id="confirmModalBody"></p>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="admin-btn-sm" style="background: rgba(0,0,0,0.05);" onclick="closeAdminModal('confirmModal')">vazgeç</button>
            <button type="button" class="admin-btn-sm" id="btnConfirmAction">Evet, Devam Et</button>
        </div>
    </div>
</div>

<div class="admin-modal-overlay" id="editModal">
    <div class="admin-modal-card">
        <div class="admin-modal-header">
            <h3>Yorum İçeriğini Düzenle</h3>
            <button type="button" class="admin-modal-close" onclick="closeAdminModal('editModal')">&times;</button>
        </div>
        <div class="admin-modal-body">
            <input type="hidden" id="editCommentId" />
            <div style="margin-bottom: 1rem;">
                <label style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">yorum metni</label>
                <textarea id="editCommentContent" rows="5" style="resize: vertical;"></textarea>
            </div>
        </div>
        <div class="admin-modal-footer">
            <button type="button" class="admin-btn-sm" style="background: rgba(0,0,0,0.05);" onclick="closeAdminModal('editModal')">iptal</button>
            <button type="button" class="admin-btn-sm btn-admin-dark" id="btnSaveComment">değişiklikleri kaydet</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function toggleCommentDetail(id) {
        const previewBlock = document.getElementById(`preview-${id}`);
        const fullBlock = document.getElementById(`full-${id}`);
        if (previewBlock.style.display === "none") {
        previewBlock.style.display = "block";
        fullBlock.style.display = "none";
        } else {
        previewBlock.style.display = "none";
        fullBlock.style.display = "block";
        }
        }

        function openAdminModal(modalId) {
        $(`#${modalId}`).css('display', 'flex').hide().fadeIn(150);
        }
        function closeAdminModal(modalId) {
        $(`#${modalId}`).fadeOut(150);
        }

        $(document).ready(function () {
        let targetId = 0;
        let targetUrl = "";
        let requestData = {};

        const baseRoute = "/Comment";

        $('.status-btn').click(function () {
        targetId = $(this).data('id');
        let status = $(this).data('status');
        targetUrl = `${baseRoute}/UpdateStatus`;
        requestData = { id: targetId, status: status };

        $('#confirmModalTitle').text("yorum durumu güncelleme");
        $('#confirmModalBody').text("Bu yorumu onaylayarak sitede yayınlamak istediğinize emin misiniz?");
        $('#btnConfirmAction').removeClass().addClass('admin-btn-sm btn-admin-success').text("evet, onayla");
        openAdminModal('confirmModal');
        });

        $('.reject-btn').click(function () {
        targetId = $(this).data('id');
        let status = $(this).data('status');
        targetUrl = `${baseRoute}/UpdateStatus`;
        requestData = { id: targetId, status: status };

        $('#confirmModalTitle').text("yorum reddetme işlemi");
        $('#confirmModalBody').text("Bu yorumu reddetmek istediğinize emin misiniz? Yorum vitrinden kaldırılacaktır.");
        $('#btnConfirmAction').removeClass().addClass('admin-btn-sm btn-admin-danger').text("evet, reddet");
        openAdminModal('confirmModal');
        });

        $('.delete-btn').click(function () {
        targetId = $(this).data('id');
        targetUrl = `${baseRoute}/DeleteComment`;
        requestData = { id: targetId };

        $('#confirmModalTitle').text("yorumu tamamen sil");
        $('#confirmModalBody').text("Bu yorumu veritabanından kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz.");
        $('#btnConfirmAction').removeClass().addClass('admin-btn-sm btn-admin-danger').text("evet, kalıcı olarak sil");
        openAdminModal('confirmModal');
        });

        $('#btnConfirmAction').click(function () {
        $.ajax({
        type: "POST",
        url: targetUrl,
        data: requestData,
        success: function (response) {
        closeAdminModal('confirmModal');
        if (response.isSuccess || response.success) {
        if (targetUrl.includes("DeleteComment")) {
        $(`#row-${targetId}`).fadeOut(400, function() { $(this).remove(); });
        } else {
        location.reload();
        }
        } else {
        alert(response.message || "Bir hata meydana geldi.");
        }
        },
        error: function() {
        closeAdminModal('confirmModal');
        alert("Teknik bir hata nedeniyle işlem tamamlanamadı.");
        }
        });
        });

        $('.edit-btn').click(function () {
        let id = $(this).data('id');
        let currentContent = $(`#row-${id} .comment-full-block .comment-text`).text().trim() || $(`#row-${id} .comment-wrapper-cell .comment-text`).text().trim();

        $('#editCommentId').val(id);
        $('#editCommentContent').val(currentContent);
        openAdminModal('editModal');
        });

        $('#btnSaveComment').click(function () {
        let id = $('#editCommentId').val();
        let newContent = $('#editCommentContent').val();

        $.ajax({
        type: "POST",
        url: `${baseRoute}/EditComment`,
        data: { id: id, content: newContent },
        success: function (response) {
        closeAdminModal('editModal');
        if (response.isSuccess || response.success) {
        location.reload();
        } else {
        alert(response.message || "Güncelleme başarısız oldu.");
        }
        },
        error: function() {
        closeAdminModal('editModal');
        alert("Teknik bir hata nedeniyle yorum güncellenemedi.");
        }
        });
        });
        });
    </script>
}