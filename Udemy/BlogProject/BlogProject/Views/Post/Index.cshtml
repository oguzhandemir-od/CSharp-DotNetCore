@using BlogProject.Features.Posts.DTOs
@model List<PostViewDto>

@{
    ViewData["Title"] = "Makale Yönetimi";
    Layout = "_Layout"; 
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text text-primary"></i> Makale Yönetim Paneli</h2>
    <a href="/Post/Create" class="btn btn-success fw-bold">
        <i class="bi bi-plus-circle"></i> Yeni Makale Oluştur
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 80px;">Görsel</th>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Yazar</th>
                    <th>Tarih</th>
                    <th class="text-center">Yorumlar</th>
                    <th class="text-end" style="width: 200px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            Henüz listelenecek bir makale bulunamadı.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var post in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(post.Image))
                                {
                                    <img src="@post.Image" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light text-muted rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 0.8rem;">Yok</div>
                                }
                            </td>
                            <td>
                                <a href="/Post/Edit/@post.Id" class="fw-bold text-decoration-none text-dark">
                                    @post.Title
                                </a>
                            </td>
                            <td><span class="badge bg-secondary">@post.CategoryName</span></td>
                            <td><strong>@post.AuthorName</strong></td>
                            <td><small class="text-muted">@post.CreatedDate.ToString("dd.MM.yyyy")</small></td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark fw-bold">@post.CommentCount</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/Post/Edit/@post.Id" class="btn btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a href="/Home/PostDetails/@post.Id" target="_blank" class="btn btn-outline-secondary" title="Sitede Gör">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <button type="button" class="btn btn-outline-danger btn-delete-post" data-id="@post.Id" data-title="@post.Title" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> Makale Silme Onayı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>"<span id="deletePostTitle"></span>"</strong> başlıklı makaleyi silmek istediğinize emin misiniz?</p>
                <p class="text-muted small mb-0">Not: Bu işlem makaleyi tamamen silmez, arşivler (IsDeleted = true).</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" id="btnConfirmDelete" class="btn btn-danger fw-bold">Evet, Sil</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        let selectedPostId = 0;
        let currentRow = null;

        $('.btn-delete-post').click(function () {
        selectedPostId = $(this).data('id');
        let postTitle = $(this).data('title');
        currentRow = $(this).closest('tr'); 

        $('#deletePostTitle').text(postTitle);
        $('#deleteModal').modal('show');
        });

        $('#btnConfirmDelete').click(function () {
        let token = $('input[name="__RequestVerificationToken"]').val(); 

        $.ajax({
        type: "POST",
        url: "/Post/Delete/" + selectedPostId,
        data: {
        __RequestVerificationToken: token
        },
        success: function (response) {
        $('#deleteModal').modal('hide'); 
        if (response.success) {
        currentRow.fadeOut(500, function () {
        $(this).remove();
        });
        } else {
        alert(response.message); 
        }
        },
        error: function () {
        $('#deleteModal').modal('hide');
        alert("Silme işlemi sırasında teknik bir hata oluştu.");
        }
        });
        });
        });
    </script>
}