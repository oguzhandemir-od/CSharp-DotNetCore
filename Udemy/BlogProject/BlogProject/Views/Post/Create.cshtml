@using BlogProject.Features.Posts.DTOs
@model PostDto

@{
    bool isEditMode = Model?.Id.HasValue ?? false;
    ViewData["Title"] = isEditMode ? "makaleyi düzenle" : "yeni makale oluştur";
    Layout = "_AdminLayout"; 
}

<div class="table-responsive" style="max-width: 900px; margin: 0 auto; padding: 2.5rem;">

    <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--admin-border); padding-bottom: 1rem;">
        <h2 style="font-family: var(--font-serif); font-size: 24px; font-weight: 600; color: var(--admin-text); margin: 0;">
            @ViewData["Title"]
        </h2>
        <p style="font-size: 12px; color: var(--admin-text-muted); font-family: var(--font-mono); margin-top: 4px;">
            @(isEditMode ? "mevcut makale içeriğini güncelliyorsunuz" : "düşüncelerinizi deftere dökün")
        </p>
    </div>

    <form asp-area="Admin" asp-controller="Post" asp-action="Save" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" style="color: var(--admin-accent); font-family: var(--font-mono); font-size: 12px; margin-bottom: 1.5rem;"></div>

        <input type="hidden" asp-for="Id" id="postHiddenId" />

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-bottom: 1.5rem;">

            <div>
                <div style="margin-bottom: 1.25rem;">
                    <label asp-for="Title" style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">makale başlığı</label>
                    <input asp-for="Title" placeholder="Örn: .NET Core Security Prensipleri" />
                    <span asp-validation-for="Title" style="color: var(--admin-accent); font-size: 11px; font-family: var(--font-mono); display: block; margin-top: 4px;"></span>
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label asp-for="CategoryId" style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">kategori</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories">
                        <option value="">-- lütfen kategori seçin --</option>
                    </select>
                    <span asp-validation-for="CategoryId" style="color: var(--admin-accent); font-size: 11px; font-family: var(--font-mono); display: block; margin-top: 4px;"></span>
                </div>
            </div>

            <div>
                <div style="margin-bottom: 1.25rem;">
                    <label asp-for="Image" style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">görsel url</label>
                    <input asp-for="Image" id="postImageUrlInput" placeholder="https://site.com/resim.jpg" />
                    <span asp-validation-for="Image" style="color: var(--admin-accent); font-size: 11px; font-family: var(--font-mono); display: block; margin-top: 4px;"></span>
                </div>

                <div id="postImagePreviewContainer" style="height: 108px; background: rgba(0,0,0,0.02); border: 1px solid var(--admin-border); border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                    @if (!string.IsNullOrEmpty(Model?.Image))
                    {
                        <img src="@Model.Image" id="postImagePreview" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="" id="postImagePreview" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                        <span id="imgPreviewText" style="color: var(--admin-text-muted); font-size: 12px; font-family: var(--font-mono); padding: 1rem; text-align: center;">görsel url girildiğinde burada önizlenir.</span>
                    }
                </div>
            </div>

        </div>

        <div style="margin-bottom: 2rem;">
            <label asp-for="Content" style="display:block; margin-bottom:8px; font-weight:500; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--admin-text-muted);">makale içeriği</label>
            <textarea asp-for="Content" rows="12" placeholder="Blog yazınızı buraya dökün..." style="font-family: var(--font-sans); line-height: 1.6; resize: vertical;"></textarea>
            <span asp-validation-for="Content" style="color: var(--admin-accent); font-size: 11px; font-family: var(--font-mono); display: block; margin-top: 4px;"></span>
        </div>

        <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--admin-border); padding-top: 1.5rem;">
            <a asp-action="Index" class="admin-btn-sm" style="background: rgba(0,0,0,0.05); color: var(--admin-text); text-decoration: none;">
                iptal
            </a>
            <button type="submit" class="admin-btn-sm btn-admin-dark" style="padding: 10px 32px !important;">
                @(isEditMode ? "değişiklikleri kaydet" : "makaleyi yayınla")
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
        function handleImagePreview(url) {
        const $previewImg = $('#postImagePreview');
        const $previewText = $('#imgPreviewText');

        if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/'))) {
        $previewImg.attr('src', url).show();
        $previewText.hide();
        } else {
        $previewImg.attr('src', '').hide();
        $previewText.show();
        }
        }

        handleImagePreview($('#postImageUrlInput').val().trim());

        $('#postImageUrlInput').on('input propertychange paste', function () {
        handleImagePreview($(this).val().trim());
        });
        });
    </script>
}