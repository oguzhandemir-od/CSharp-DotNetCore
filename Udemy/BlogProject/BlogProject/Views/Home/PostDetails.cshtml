@using BlogProject.Features.Posts.DTOs
@model PostViewDto

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<article class="article-detail">
    <header class="article-header">
        <span class="article-category">#@Model.CategoryName</span>
        <h1>@Model.Title</h1>

        <div class="article-meta">
            <span>@Model.CreatedDate.ToString("dd MMMM yyyy HH:mm")</span> &middot;
            <span>yazar: <strong>@Model.AuthorName</strong></span>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <img class="article-image" src="@Model.Image" alt="@Model.Title" />
    }
    else
    {
        <img class="article-image" src="https://placeholder.pics/svg/900x400/ECECEC/D2D2D2-626262/Gorsel-Yok" alt="Görsel Yok" />
    }

    <section class="article-body">
        <p>@Model.Content</p>
    </section>
</article>

<section class="comment-section">
    <h4>tartışma (@Model.CommentCount)</h4>

    <form id="commentForm" style="margin-bottom: 2rem;">
        @Html.AntiForgeryToken()
        <input type="hidden" id="postId" value="@Model.Id" />

        <div style="margin-bottom: 1rem;">
            <textarea id="commentContent" class="modern-textarea" rows="3" placeholder="topluluk kurallarına uygun bir yorum bırakın..."></textarea>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-family: var(--font-mono); font-size: 11px; color: var(--muted);">
                * onay sonrasında listelenir
            </span>
            <button type="button" id="btnSubmitComment" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">
                Yorumu Yayınla
            </button>
        </div>
    </form>

    <div id="commentsList">
        @if (Model.Comments == null || !Model.Comments.Any())
        {
            <p id="noCommentAlert" style="font-family: var(--font-mono); font-size: 13px; color: var(--muted); text-align: center; padding: 2rem 0;">
                bu yazıya henüz yorum yapılmamış. ilk adımı siz atın.
            </p>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="comment-item">
                    <div class="comment-avatar">
                        @comment.Username.Substring(0, 1).ToUpper()
                    </div>
                    <div class="comment-main">
                        <h5>
                            @comment.Username
                            <span class="comment-date">&middot; @comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                        </h5>
                        <div class="comment-text">@comment.Content</div>
                    </div>
                </div>
            }
        }
    </div>

    <div style="margin-top: 3rem; text-align: center;">
        <a href="/Home/Index" style="font-family: var(--font-mono); font-size: 13px; color: var(--muted);">
            &larr; anasayfaya geri dön
        </a>
    </div>
</section>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
        $('#btnSubmitComment').click(function () {
        let content = $('#commentContent').val().trim();
        let postId = $('#postId').val();
        let token = $('input[name="__RequestVerificationToken"]').val();

        if (!content) {
        alert("Yorum içeriği boş bırakılamaz.");
        return;
        }

        $.ajax({
        type: "POST",
        url: "/Comment/Create",
        data: {
        postId: parseInt(postId),
        content: content,
        __RequestVerificationToken: token
        },
        success: function (response) {
        if (response.success) {
        $('#commentContent').val('');
        alert("Yorumunuz başarıyla gönderildi! Kontrol edildikten sonra yayınlanacaktır.");
        } else {
        alert(response.message);
        }
        },
        error: function () {
        alert("Yorum gönderilirken teknik bir hata oluştu.");
        }
        });
        });
        });
    </script>
}