@using BlogProject.Features.Posts.DTOs
@model List<PostViewDto>

@{
    ViewData["Title"] = "Ana Sayfa - Blog";
    
    Layout = "_Layout";
}

<header class="py-5 bg-light border-bottom mb-4">
    <div class="container">
        <div class="text-center my-5">
            <h1 class="fw-bolder">Bilgi ve Deneyim Paylaşım Platformu</h1>
            <p class="lead mb-0 text-muted">FBS Yaklaşımı ve Hibrit SPA Mimarisiyle Geliştirilmiş Modern Blog</p>
        </div>
    </div>
</header>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center" role="alert">
                    <h4 class="alert-heading">Henüz Yazı Yok!</h4>
                    <p class="mb-0">Sitemizde henüz yayınlanmış bir makale bulunmamaktadır. Daha sonra tekrar uğrayın.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var post in Model)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 shadow-sm border-0">
                                @if (!string.IsNullOrEmpty(post.Image))
                                {
                                    <img class="card-img-top" src="@post.Image" alt="@post.Title" style="height: 200px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img class="card-img-top" src="https://placeholder.pics/svg/800x400/ECECEC/D2D2D2-626262/Gorsel-Yok" alt="Görsel Yok" style="height: 200px; object-fit: cover;" />
                                }

                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary">@post.CategoryName</span>
                                        <small class="text-muted">@post.CreatedDate.ToString("dd MMM yyyy")</small>
                                    </div>

                                    <h4 class="card-title h5 fw-bold">@post.Title</h4>

                                    <p class="card-text text-muted flex-grow-1">
                                        @(post.Content.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                                    </p>

                                    <hr class="my-2" />

                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <div class="small">
                                            <i class="bi bi-person-fill text-secondary"></i> <strong>@post.AuthorName</strong>
                                            <span class="text-muted ms-2"><i class="bi bi-chat-fill"></i> @post.CommentCount</span>
                                        </div>
                                        <a class="btn btn-sm btn-outline-primary fw-bold" href="/Home/PostDetails/@post.Id">
                                            Devamını Oku →
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">Blogda Ara</div>
                <div class="card-body">
                    <div class="input-group">
                        <input class="form-control" type="text" placeholder="Anahtar kelime girin..." aria-label="Anahtar kelime girin..." />
                        <button class="btn btn-primary" id="button-search" type="button">Ara</button>
                    </div>
                </div>
            </div>

            <div class="card mb-4 border-0 shadow-sm border-start border-4 border-warning">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="bi bi-shield-fill-check"></i> Topluluk İlkelerimiz
                </div>
                <div class="card-body site-rules-box">
                    <p class="card-text small text-muted mb-2">
                        Platformumuzda fikir özgürlüğüne değer veriyoruz. Yazarlarımız ve moderatörlerimiz yorumları içeriklerine göre değil, sadece topluluk kurallarına göre denetler.
                    </p>
                    <ul class="small text-muted ps-3 mb-0">
                        <li>Küfür, hakaret ve nefret söylemi yasaktır.</li>
                        <li>Reklam ve spam içerikler onaylanmaz.</li>
                        <li>Farklı görüşlere saygı esastır.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}